---
const path = Astro.url.pathname;
const links = [
  { href: "/experiments/", label: "Experiments", match: "/experiments" },
  { href: "/about/", label: "About", match: "/about" },
];
const isCurrent = (href: string) =>
  href === "/experiments/" ? path === "/experiments/" : path.startsWith(href);
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="SORT VOID home">
      <span>SORT</span><span class="slash">//</span><span>VOID</span><span class="cursor" aria-hidden="true"></span>
    </a>
    <nav class="nav" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="sound-group">
      <button id="sound-toggle" class="sound-btn" type="button" aria-pressed="false" title="Toggle generative audio">
        <span class="sound-dot" aria-hidden="true"></span>
        <span>SOUND</span>
        <b id="sound-state">OFF</b>
      </button>
    </div>
  </div>
</header>

<script>
  import { audio } from "../engines/audio/audio";

  const btn = document.getElementById("sound-toggle") as HTMLButtonElement | null;
  const state = document.getElementById("sound-state");

  function sync() {
    const on = audio.on;
    if (btn) btn.setAttribute("aria-pressed", String(on));
    if (state) state.textContent = on ? "ON" : "OFF";
    if (btn) btn.classList.toggle("is-on", on);
  }

  btn?.addEventListener("click", async () => {
    await audio.toggle();
    sync();
  });

  audio.subscribe(sync);
  sync();
</script>
