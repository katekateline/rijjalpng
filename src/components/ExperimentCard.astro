---
import type { Experiment } from "../data/experiments";

interface Props {
  exp: Experiment;
  index?: number;
}

const { exp, index } = Astro.props;
---

<a class="exp-card" href={exp.href}>
  <div class="thumb-wrap">
    <span class="thumb-id">{String(index ?? 0).padStart(2, "0")}</span>
    <pre class="thumb" aria-hidden="true">{exp.art}</pre>
  </div>
  <div class="card-meta">
    <span>{exp.category}</span>
    <span class="diff" data-level={exp.difficulty}>{exp.difficulty}</span>
  </div>
  <h3>{exp.name}</h3>
  <p>{exp.desc}</p>
  <div class="enter"><span>ENTER EXPERIMENT</span><span class="arrow">→</span></div>
</a>

<style>
  .exp-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: var(--panel);
    padding: 0.85rem;
    min-height: 100%;
    transition: border-color 140ms linear, background 140ms linear;
    position: relative;
  }

  .exp-card:hover,
  .exp-card:focus-visible {
    border-color: var(--line-hot);
    background: var(--panel-hi);
  }

  .thumb-wrap {
    position: relative;
    border: 1px solid #101b14;
    background: #060a08;
    padding: 0.75rem 0.6rem;
    overflow: hidden;
    margin-bottom: 0.8rem;
  }

  .thumb-id {
    position: absolute;
    top: 4px;
    right: 6px;
    font-size: 8px;
    color: var(--dim);
    letter-spacing: 0.12em;
  }

  .thumb {
    color: var(--green);
    opacity: 0.78;
    font-size: 10px;
    line-height: 1.18;
    white-space: pre;
    text-shadow: 0 0 5px rgba(77, 255, 145, 0.28);
    transition: opacity 140ms linear;
  }

  .exp-card:hover .thumb {
    opacity: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 8px;
    letter-spacing: 0.14em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .diff[data-level="MED"] { color: var(--cyan); }
  .diff[data-level="HIGH"] { color: var(--green-2); }

  h3 {
    margin: 0.35rem 0 0.25rem;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  p {
    font-size: 11px;
    color: var(--muted);
    line-height: 1.5;
    margin-bottom: 0.9rem;
  }

  .enter {
    margin-top: auto;
    padding-top: 0.65rem;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    font-size: 9px;
    letter-spacing: 0.16em;
    color: var(--green);
    text-transform: uppercase;
  }

  .arrow {
    transition: transform 140ms ease;
  }

  .exp-card:hover .arrow {
    transform: translateX(4px);
  }
</style>
