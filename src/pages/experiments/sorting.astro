---
import Base from "../../layouts/Base.astro";
import { SORT_ALGORITHMS } from "../../engines/sorting/algorithms";
---

<Base title="SORT//VOID — Sorting Lab" description="Seven sorting algorithms executed live in ASCII character memory.">
  <div class="page-head">
    <div>
      <div class="crumb"><a href="/experiments/">EXPERIMENTS</a> / SORTING</div>
      <h1>SORTING <em>LAB</em></h1>
      <p>Seven ordering algorithms, rendered as character memory. Comparisons, swaps and pivots are recorded from the actual run — never simulated for looks.</p>
    </div>
    <div class="head-index">EXP_01<br /><b>SORTING</b><br />7 ALGORITHMS</div>
  </div>

  <section class="console panel" id="console" aria-label="Interactive sorting visualiser">
    <div class="panel-head">
      <span class="title">ASCII SORT ENGINE</span>
      <span id="engine-state">READY</span>
    </div>

    <div class="controls">
      <label class="field">ALGORITHM
        <select id="algo-select">
          {SORT_ALGORITHMS.map((algo) => <option value={algo.id}>{algo.name}</option>)}
        </select>
      </label>
      <label class="field">ORDER
        <select id="order-select">
          <option value="asc">ASCENDING</option>
          <option value="desc">DESCENDING</option>
        </select>
      </label>
      <label class="field">ARRAY SIZE
        <select id="size-select">
          <option value="8">08</option>
          <option value="12">12</option>
          <option value="16">16</option>
          <option value="24" selected>24</option>
          <option value="32">32</option>
          <option value="48">48</option>
          <option value="64">64</option>
        </select>
      </label>
      <label class="field">SPEED · STEPS/SEC
        <input id="speed-range" type="range" min="1" max="200" step="1" value="30" />
        <output id="speed-out" for="speed-range">30</output>
      </label>
    </div>

    <div class="console-grid">
      <div class="viz-col">
        <div class="viz-head">
          <span>ARRAY MEMORY <b id="mem-size">24 CELLS</b></span>
          <span id="op-readout">READY — ARRAY INITIALISED</span>
        </div>
        <div class="ascii-wrap">
          <pre id="sort-ascii" class="ascii" role="img" aria-label="ASCII bar visualisation of the sorting array"></pre>
        </div>
        <div class="legend" aria-label="Character legend">
          <span><b>█</b> ACTIVE</span>
          <span><b>▓</b> COMPARE</span>
          <span><b>▒</b> SWAP</span>
          <span class="idle">░</span><span>IDLE</span>
          <span><b>@</b> PIVOT</span>
          <span><b>*</b> SORTED</span>
          <span><b>|</b> POINTER</span>
        </div>

        <div class="source-panel">
          <div class="panel-head">
            <span class="title">SOURCE / TYPESCRIPT</span>
            <span id="algo-tag">BUBBLE</span>
          </div>
          <div id="source" class="source" aria-label="Algorithm source code"></div>
        </div>
      </div>

      <aside class="side-col">
        <div class="panel-head">
          <span class="title">TELEMETRY</span>
          <span>LIVE</span>
        </div>
        <dl class="telemetry">
          <div class="metric metric--wide">
            <dt>OPERATION</dt>
            <dd id="stat-op" class="accent">—</dd>
          </div>
          <div class="metric">
            <dt>INDICES</dt>
            <dd id="stat-idx">—</dd>
          </div>
          <div class="metric">
            <dt>ITERATION</dt>
            <dd id="stat-iter">0</dd>
          </div>
          <div class="metric">
            <dt>COMPARISONS</dt>
            <dd id="stat-comp">0</dd>
          </div>
          <div class="metric">
            <dt>SWAPS</dt>
            <dd id="stat-swap">0</dd>
          </div>
          <div class="metric">
            <dt>WRITES</dt>
            <dd id="stat-write">0</dd>
          </div>
          <div class="metric">
            <dt>SORTED</dt>
            <dd id="stat-sorted">0</dd>
          </div>
          <div class="metric metric--wide">
            <dt>EXECUTION PROGRESS</dt>
            <dd><span id="progress" class="progress">[░░░░░░░░░░░░░░░░░░░░] 0%</span></dd>
          </div>
        </dl>

        <div class="transport">
          <button class="btn btn--primary" id="btn-play" type="button">▶ PLAY</button>
          <button class="btn" id="btn-step" type="button">▸ STEP</button>
          <button class="btn btn--ghost" id="btn-reset" type="button">↺ RESET</button>
          <button class="btn btn--ghost" id="btn-random" type="button">⤨ SHUFFLE</button>
        </div>

        <div class="hint-row">
          <span><span class="kbd">SPACE</span> PLAY/PAUSE</span>
          <span><span class="kbd">→</span> STEP</span>
          <span><span class="kbd">R</span> RESET</span>
          <span><span class="kbd">N</span> NEW ARRAY</span>
        </div>

        <div class="side-note">
          <span class="overline">RENDERER</span>
          <p>One preformatted text surface. Algorithm execution produces an event trace; the player replays it at a fixed step rate. All metrics come from the trace.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="brief" aria-labelledby="brief-name">
    <div class="brief-main">
      <div class="eyebrow">ALGORITHM BRIEF</div>
      <h2 id="brief-name">Bubble Sort</h2>
      <p id="brief-desc"></p>
    </div>
    <dl class="complexity" id="complexity"></dl>
  </section>
</Base>

<style>
  .controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.8rem;
    padding: 0.85rem;
    border-bottom: 1px solid var(--line);
    background: #070b09;
  }

  .controls .field:last-child { grid-column: span 1; }

  .console-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.62fr) minmax(280px, 0.78fr);
  }

  .viz-col { min-width: 0; }

  .viz-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.85rem;
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
  }

  .viz-head b { color: var(--green); font-weight: 400; }

  #op-readout {
    color: var(--cyan);
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .viz-col .ascii-wrap { background: #060a08; }

  #sort-ascii {
    padding: 1rem 0.85rem 0.65rem;
    font-size: clamp(5.5px, 0.82vw, 10px);
    line-height: 1.14;
    min-width: max-content;
    margin: 0 auto;
    display: block;
    width: max-content;
  }

  .side-col {
    border-left: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .side-col > * { flex-shrink: 0; }

  .transport {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem;
    padding: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .hint-row {
    padding: 0.75rem 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .side-note {
    padding: 0.9rem;
    font-size: 10px;
    color: var(--muted);
    line-height: 1.55;
    margin-top: auto;
  }

  .side-note p { margin-top: 0.35rem; }

  .source-panel { border-top: 1px solid var(--line); }

  .source { border-top: 0; }

  .progress {
    color: var(--green);
    font-size: 11px;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .brief {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.7fr);
    gap: 2rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .brief h2 {
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    letter-spacing: -0.03em;
    margin: 0.5rem 0 0.6rem;
  }

  .brief-main p {
    color: var(--muted);
    max-width: 68ch;
    font-size: 12px;
    line-height: 1.7;
  }

  .complexity {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    align-self: start;
  }

  .complexity div {
    padding: 0.55rem 0.7rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .complexity dt {
    font-size: 8px;
    letter-spacing: 0.14em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .complexity dd {
    margin: 2px 0 0;
    font-size: 13px;
    color: var(--green);
  }

  @media (max-width: 900px) {
    .console-grid { grid-template-columns: 1fr; }
    .side-col { border-left: 0; border-top: 1px solid var(--line); }
    .brief { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>

<script>
  import { getAlgorithm } from "../../engines/sorting/algorithms";
  import type { Order, SortStep } from "../../engines/sorting/types";
  import { audio } from "../../engines/audio/audio";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const consoleEl = $("console");
  const algoSelect = $<HTMLSelectElement>("algo-select");
  const orderSelect = $<HTMLSelectElement>("order-select");
  const sizeSelect = $<HTMLSelectElement>("size-select");
  const speedRange = $<HTMLInputElement>("speed-range");
  const speedOut = $("speed-out");
  const asciiEl = $<HTMLPreElement>("sort-ascii");
  const sourceEl = $("source");
  const stateEl = $("engine-state");
  const opEl = $("op-readout");
  const statOp = $("stat-op");
  const statIdx = $("stat-idx");
  const statIter = $("stat-iter");
  const statComp = $("stat-comp");
  const statSwap = $("stat-swap");
  const statWrite = $("stat-write");
  const statSorted = $("stat-sorted");
  const progressEl = $("progress");
  const memSize = $("mem-size");
  const algoTag = $("algo-tag");
  const briefName = $("brief-name");
  const briefDesc = $("brief-desc");
  const complexityEl = $("complexity");
  const playBtn = $<HTMLButtonElement>("btn-play");
  const stepBtn = $<HTMLButtonElement>("btn-step");
  const resetBtn = $<HTMLButtonElement>("btn-reset");
  const randomBtn = $<HTMLButtonElement>("btn-random");

  const ROWS = 16;
  const TOTAL_PROGRESS = 20;

  const params = new URLSearchParams(location.search);
  let algo = getAlgorithm(params.get("algo"));
  let order: Order = params.get("order") === "desc" ? "desc" : "asc";
  let values = shuffled(Number(sizeSelect.value));
  let trace: SortStep[] = [];
  let cursor = 0;
  let playing = false;
  let speed = Number(speedRange.value);
  let raf = 0;
  let last = 0;
  let acc = 0;
  let wasPlaying = false;

  function shuffled(size: number) {
    const arr = Array.from({ length: size }, (_, i) => i + 1);
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function highlight(line: string) {
    const escaped = line.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    return escaped
      .replace(/(\/\/.*)$/, '<span class="tok-com">$1</span>')
      .replace(/\b(function|const|let|for|while|if|else|return|break|continue|Math|true|false)\b/g, '<span class="tok-kw">$1</span>')
      .replace(/\b(\d+)\b/g, '<span class="tok-num">$1</span>')
      .replace(/\b([a-zA-Z_$][\w$]*)(?=\()/g, '<span class="tok-fn">$1</span>');
  }

  function renderSource() {
    sourceEl.innerHTML = algo.code
      .map((line, i) => {
        const n = String(i + 1).padStart(2, "0");
        return `<div class="src-line" data-line="${i + 1}"><span class="ln">${n}</span><span class="src-txt">${highlight(line) || " "}</span></div>`;
      })
      .join("");
    algoTag.textContent = algo.id.toUpperCase();
  }

  function renderBrief() {
    briefName.textContent = algo.name;
    briefDesc.textContent = algo.description;
    const c = algo.complexity;
    const cells: [string, string][] = [
      ["BEST", c.best],
      ["AVERAGE", c.average],
      ["WORST", c.worst],
      ["SPACE", c.space],
      ["STABLE", c.stable ? "YES" : "NO"],
      ["METHOD", algo.blurb],
    ];
    complexityEl.innerHTML = cells
      .map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`)
      .join("");
  }

  function charFor(i: number, step: SortStep, indices: Set<number>, sorted: Set<number>) {
    if (step.kind === "swap" && indices.has(i)) return "▒";
    if (step.kind === "compare" && indices.has(i)) return "▓";
    if (step.kind === "write" && indices.has(i)) return "█";
    if (step.pivot === i) return "@";
    if (sorted.has(i)) return "*";
    return "░";
  }

  function fitAscii(n: number) {
    const wrap = asciiEl.parentElement;
    if (!wrap) return;
    const available = wrap.clientWidth - 32;
    const size = Math.max(5.5, Math.min(19, available / ((n * 2 + 2) * 0.6)));
    asciiEl.style.fontSize = `${size.toFixed(1)}px`;
  }

  function renderAscii(step: SortStep) {
    const n = step.values.length;
    fitAscii(n);
    const indices = new Set(step.indices);
    const sorted = new Set(step.sorted);
    const out: string[] = [];

    for (let r = ROWS - 1; r >= 0; r--) {
      let line = "  ";
      for (let i = 0; i < n; i++) {
        const height = Math.max(1, Math.ceil((step.values[i] / n) * ROWS));
        line += (height > r ? charFor(i, step, indices, sorted) : " ") + " ";
      }
      out.push(line.replace(/\s+$/, ""));
    }

    let pointer = "  ";
    const ruler = Array.from({ length: 2 + n * 2 }, () => " ");
    for (let i = 0; i < n; i++) pointer += (indices.has(i) ? "|" : " ") + " ";
    for (let i = 0; i < n; i += 8) {
      const label = String(i);
      for (let k = 0; k < label.length; k++) ruler[2 + i * 2 + k] = label[k];
    }
    out.push(pointer.replace(/\s+$/, ""), ruler.join("").replace(/\s+$/, ""));
    asciiEl.textContent = out.join("\n");
    asciiEl.setAttribute("aria-label", `${algo.name}: ${n} elements, ${step.note}`);
  }

  function render() {
    const step = trace[cursor];
    if (!step) return;

    renderAscii(step);

    statOp.textContent = step.note;
    statIdx.textContent = step.indices.length ? step.indices.join(" / ") : "—";
    statIter.textContent = String(cursor);
    statComp.textContent = String(step.comparisons);
    statSwap.textContent = String(step.swaps);
    statWrite.textContent = String(step.writes);
    statSorted.textContent = `${step.sorted.length}/${step.values.length}`;
    opEl.textContent = `${step.kind.toUpperCase()} — ${step.note}`.toUpperCase();

    const pct = Math.round((cursor / Math.max(1, trace.length - 1)) * 100);
    const filled = Math.round((pct / 100) * TOTAL_PROGRESS);
    progressEl.textContent = `[${"█".repeat(filled)}${"░".repeat(TOTAL_PROGRESS - filled)}] ${pct}%`;
    memSize.textContent = `${step.values.length} CELLS`;

    const active = sourceEl.querySelector<HTMLElement>(`.src-line[data-line="${step.line}"]`);
    sourceEl.querySelectorAll(".src-line.is-active").forEach((el) => el.classList.remove("is-active"));
    if (active) {
      active.classList.add("is-active");
      const target = active.offsetTop - sourceEl.clientHeight / 2 + active.clientHeight / 2;
      sourceEl.scrollTop = Math.max(0, target);
    }

    if (cursor >= trace.length - 1) stateEl.textContent = "COMPLETE";
    else stateEl.textContent = playing ? `RUNNING · ${speed} STP/S` : "PAUSED";
    stepBtn.disabled = cursor >= trace.length - 1;
    playBtn.textContent = playing ? "❚❚ PAUSE" : cursor >= trace.length - 1 ? "▶ REPLAY" : "▶ PLAY";
  }

  function rebuild() {
    trace = algo.run(values, order);
    cursor = 0;
    stop();
    renderSource();
    renderBrief();
    render();
  }

  function play() {
    if (cursor >= trace.length - 1) cursor = 0;
    if (!trace.length) return;
    playing = true;
    last = 0;
    acc = 0;
    stateEl.textContent = `RUNNING · ${speed} STP/S`;
    playBtn.textContent = "❚❚ PAUSE";
    render();
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(frame);
  }

  function stop() {
    playing = false;
    cancelAnimationFrame(raf);
    raf = 0;
    if (trace.length) {
      stateEl.textContent = cursor >= trace.length - 1 ? "COMPLETE" : "PAUSED";
      playBtn.textContent = cursor >= trace.length - 1 ? "▶ REPLAY" : "▶ PLAY";
    }
  }

  function frame(ts: number) {
    if (!playing) return;
    if (!last) last = ts;
    acc += ts - last;
    last = ts;
    const interval = 1000 / speed;
    let advance = 0;
    while (acc >= interval && advance < 200) {
      acc -= interval;
      advance++;
    }
    if (advance) {
      cursor = Math.min(trace.length - 1, cursor + advance);
      render();
      soundAt(cursor);
      if (cursor >= trace.length - 1) {
        stop();
        render();
        return;
      }
    }
    raf = requestAnimationFrame(frame);
  }

  function stepForward() {
    if (playing) stop();
    cursor = Math.min(trace.length - 1, cursor + 1);
    soundAt(cursor);
    render();
  }

  function soundAt(index: number) {
    const step = trace[index];
    if (!step) return;
    const i = step.indices[0] ?? 0;
    const value = (step.values[i] ?? 0) / Math.max(1, step.values.length);
    audio.sortStep(step.kind, value);
  }

  function reset() {
    stop();
    cursor = 0;
    render();
  }

  function newArray() {
    const size = Number(sizeSelect.value);
    values = shuffled(size);
    rebuild();
  }

  algoSelect.value = algo.id;
  orderSelect.value = order;
  sizeSelect.value = String(values.length);
  renderSource();
  renderBrief();
  rebuild();

  algoSelect.addEventListener("change", () => {
    algo = getAlgorithm(algoSelect.value);
    const url = new URL(location.href);
    url.searchParams.set("algo", algo.id);
    history.replaceState(null, "", url);
    rebuild();
  });

  orderSelect.addEventListener("change", () => {
    order = orderSelect.value === "desc" ? "desc" : "asc";
    rebuild();
  });

  sizeSelect.addEventListener("change", newArray);
  randomBtn.addEventListener("click", newArray);
  resetBtn.addEventListener("click", reset);
  stepBtn.addEventListener("click", stepForward);
  playBtn.addEventListener("click", () => (playing ? stop() : play()));

  speedRange.addEventListener("input", () => {
    speed = Number(speedRange.value);
    speedOut.textContent = String(speed);
    if (playing) stateEl.textContent = `RUNNING · ${speed} STP/S`;
  });

  let resizeRaf = 0;
  window.addEventListener("resize", () => {
    cancelAnimationFrame(resizeRaf);
    resizeRaf = requestAnimationFrame(() => {
      const step = trace[cursor];
      if (step) fitAscii(step.values.length);
    });
  });

  window.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest("input, textarea, select, button, [contenteditable='true']")) return;
    if (e.code === "Space") {
      e.preventDefault();
      playing ? stop() : play();
    } else if (e.key === "ArrowRight") {
      e.preventDefault();
      stepForward();
    } else if (e.key.toLowerCase() === "r") {
      reset();
    } else if (e.key.toLowerCase() === "n") {
      newArray();
    }
  });

  const io = new IntersectionObserver(([entry]) => {
    if (!entry.isIntersecting) {
      if (playing) {
        wasPlaying = true;
        stop();
      }
    } else if (wasPlaying) {
      wasPlaying = false;
      play();
    }
  });
  io.observe(consoleEl);

  document.addEventListener("visibilitychange", () => {
    if (document.hidden && playing) {
      wasPlaying = true;
      stop();
    } else if (!document.hidden && wasPlaying) {
      wasPlaying = false;
      play();
    }
  });

</script>
