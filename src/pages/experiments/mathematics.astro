---
import Base from "../../layouts/Base.astro";
---

<Base title="SORT//VOID — Mathematics Fields" description="Mandelbrot, Julia, sine interference and a rotating ASCII torus generated in real time.">
  <div class="page-head">
    <div>
      <div class="crumb"><a href="/experiments/">EXPERIMENTS</a> / MATHEMATICS</div>
      <h1>MATHEMATICS <em>FIELDS</em></h1>
      <p>Iteration, interference and projection, sampled into a character grid. No image files: every cell is computed and printed each frame.</p>
    </div>
    <div class="head-index">EXP_04<br /><b>MATHEMATICS</b><br />4 FIELDS</div>
  </div>

  <section class="console panel" id="console" aria-label="Generative mathematics visualiser">
    <div class="panel-head">
      <span class="title">ASCII FIELD ENGINE</span>
      <span id="engine-state">READY</span>
    </div>

    <div class="controls">
      <label class="field">FIELD
        <select id="mode-select">
          <option value="mandelbrot">MANDELBROT SET</option>
          <option value="julia">JULIA SET</option>
          <option value="sine">SINE WAVE FIELD</option>
          <option value="torus">ROTATING TORUS</option>
        </select>
      </label>
      <label class="field">TIME SCALE
        <input id="speed-range" type="range" min="10" max="100" step="5" value="50" />
        <output id="speed-out" for="speed-range">1.0×</output>
      </label>
      <div class="field">RESOLUTION
        <div class="readout-value">90 × 30 CHAR</div>
      </div>
    </div>

    <div class="console-grid">
      <div class="viz-col">
        <div class="viz-head">
          <span>FIELD BUFFER <b id="mode-tag">MANDELBROT</b></span>
          <span id="op-readout">T+0.00s</span>
        </div>
        <div class="ascii-wrap">
          <pre id="field-ascii" class="ascii" role="img" aria-label="Generated ASCII mathematical field"></pre>
        </div>
        <div class="legend">
          <span>PALETTE</span>
          <span id="palette" class="palette">.:-=+*#%@</span>
          <span>EACH CELL = ONE CHARACTER</span>
        </div>
        <div class="viz-foot">
          <span id="foot-formula">z ← z² + c</span>
          <span>CPU / TEXT ONLY</span>
        </div>
      </div>

      <aside class="side-col">
        <div class="panel-head"><span class="title">TELEMETRY</span><span>LIVE</span></div>
        <dl class="telemetry">
          <div class="metric metric--wide">
            <dt>FIELD</dt>
            <dd id="stat-mode" class="accent">MANDELBROT SET</dd>
          </div>
          <div class="metric">
            <dt>CLOCK</dt>
            <dd id="stat-time">0.00s</dd>
          </div>
          <div class="metric">
            <dt>FPS</dt>
            <dd id="stat-fps">—</dd>
          </div>
          <div class="metric">
            <dt>ITERATIONS</dt>
            <dd id="stat-iter">42</dd>
          </div>
          <div class="metric">
            <dt>TIME SCALE</dt>
            <dd id="stat-scale">1.0×</dd>
          </div>
          <div class="metric metric--wide">
            <dt>RULE</dt>
            <dd id="stat-rule">z ← z² + c</dd>
          </div>
        </dl>

        <div class="transport">
          <button class="btn btn--primary" id="btn-play" type="button">▶ RUN</button>
          <button class="btn" id="btn-mutate" type="button">⤨ MUTATE</button>
          <button class="btn btn--ghost" id="btn-reset" type="button" style="grid-column: span 2">↺ RESET FIELD</button>
        </div>

        <div class="hint-row">
          <span><span class="kbd">SPACE</span> RUN/PAUSE</span>
          <span><span class="kbd">M</span> MUTATE</span>
          <span><span class="kbd">R</span> RESET</span>
        </div>

        <div class="side-note">
          <span class="overline">NOTE</span>
          <p id="side-note"></p>
        </div>
      </aside>
    </div>
  </section>

  <section class="brief">
    <div class="brief-main">
      <div class="eyebrow">FIELD BRIEF</div>
      <h2 id="brief-name">Mandelbrot Set</h2>
      <p id="brief-desc"></p>
    </div>
    <dl class="complexity" id="complexity"></dl>
  </section>
</Base>

<style>
  .controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.8rem;
    padding: 0.85rem;
    border-bottom: 1px solid var(--line);
    background: #070b09;
  }

  .readout-value {
    border: 1px solid var(--line);
    background: #070b09;
    color: var(--green);
    padding: 0.45rem 0.6rem;
    font-size: 11px;
    min-height: 32px;
    display: flex;
    align-items: center;
  }

  .console-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(280px, 0.75fr);
  }

  .viz-col { min-width: 0; }

  .viz-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.85rem;
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
  }

  .viz-head b { color: var(--green); font-weight: 400; }

  #op-readout {
    color: var(--cyan);
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .viz-col .ascii-wrap { background: #060a08; }

  #field-ascii {
    padding: 1rem 0.75rem;
    font-size: clamp(6px, 0.92vw, 11px);
    line-height: 1.08;
    margin: 0 auto;
    width: max-content;
    color: var(--green);
  }

  .palette {
    color: var(--green);
    letter-spacing: 0.25em;
    font-size: 11px;
  }

  .viz-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.85rem;
    border-top: 1px solid var(--line);
    font-size: 8px;
    letter-spacing: 0.14em;
    color: var(--dim);
    text-transform: uppercase;
  }

  .side-col { border-left: 1px solid var(--line); display: flex; flex-direction: column; }
  .side-col > * { flex-shrink: 0; }

  .transport {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45rem;
    padding: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .hint-row { padding: 0.75rem 0.8rem; border-bottom: 1px solid var(--line); }

  .side-note { padding: 0.9rem; font-size: 10px; color: var(--muted); line-height: 1.65; margin-top: auto; }
  .side-note p { margin-top: 0.35rem; }

  .brief {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.7fr);
    gap: 2rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .brief h2 { font-size: clamp(1.4rem, 3vw, 2.2rem); letter-spacing: -0.03em; margin: 0.5rem 0 0.6rem; }
  .brief-main p { color: var(--muted); max-width: 68ch; font-size: 12px; line-height: 1.7; }

  .complexity {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    align-self: start;
  }

  .complexity div { padding: 0.55rem 0.7rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .complexity dt { font-size: 8px; letter-spacing: 0.14em; color: var(--muted); text-transform: uppercase; }
  .complexity dd { margin: 2px 0 0; font-size: 12px; color: var(--green); }

  @media (max-width: 900px) {
    .console-grid { grid-template-columns: 1fr; }
    .side-col { border-left: 0; border-top: 1px solid var(--line); }
    .brief { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>

<script>
  import { juliaFrame, mandelbrotFrame, sineFrame, torusFrame } from "../../engines/mathematics/fields";

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  type FieldId = "mandelbrot" | "julia" | "sine" | "torus";

  const COLS = 90;
  const ROWS = 30;

  const consoleEl = $("console");
  const modeSelect = $<HTMLSelectElement>("mode-select");
  const speedRange = $<HTMLInputElement>("speed-range");
  const speedOut = $("speed-out");
  const fieldEl = $<HTMLPreElement>("field-ascii");
  const stateEl = $("engine-state");
  const opEl = $("op-readout");
  const modeTag = $("mode-tag");
  const statMode = $("stat-mode");
  const statTime = $("stat-time");
  const statFps = $("stat-fps");
  const statIter = $("stat-iter");
  const statScale = $("stat-scale");
  const statRule = $("stat-rule");
  const footFormula = $("foot-formula");
  const sideNote = $("side-note");
  const briefName = $("brief-name");
  const briefDesc = $("brief-desc");
  const complexityEl = $("complexity");
  const playBtn = $<HTMLButtonElement>("btn-play");
  const mutateBtn = $<HTMLButtonElement>("btn-mutate");
  const resetBtn = $<HTMLButtonElement>("btn-reset");

  const FIELDS: Record<FieldId, {
    name: string;
    tag: string;
    formula: string;
    rule: string;
    iterations: string;
    note: string;
    desc: string;
    cells: [string, string][];
    draw: (t: number, seed: number) => string;
  }> = {
    mandelbrot: {
      name: "Mandelbrot Set",
      tag: "MANDELBROT",
      formula: "z ← z² + c",
      rule: "z ← z² + c · escape radius 2",
      iterations: "42",
      note: "Each cell is a complex coordinate. The iteration count before escape selects a character. A slow zoom breathes across the boundary; the set itself never resolves.",
      desc: "The Mandelbrot set is the boundary between complex numbers whose orbit stays bounded under z² + c and those that escape. Here each character maps to how many iterations a point survives before its magnitude exceeds two.",
      cells: [
        ["DOMAIN", "COMPLEX PLANE"],
        ["ITERATIONS", "42"],
        ["ESCAPE", "|z| > 2"],
        ["SAMPLES", "2,700"],
        ["ANIMATION", "SLOW ZOOM"],
        ["PALETTE", "10 CHARACTERS"],
      ],
      draw: (t, seed) => mandelbrotFrame(COLS, ROWS, t, seed),
    },
    julia: {
      name: "Julia Set",
      tag: "JULIA",
      formula: "z ← z² + c(t)",
      rule: "c = 0.7885 · e^(iθ)",
      iterations: "40",
      note: "A Julia set is drawn for a fixed c. Here that constant orbits the unit circle, so the whole family morphs through connected and dust-like states.",
      desc: "Where Mandelbrot varies c per point, a Julia set fixes c and varies the starting z. Animating c around a circle reveals the family of shapes hidden inside the Mandelbrot map.",
      cells: [
        ["DOMAIN", "COMPLEX PLANE"],
        ["ITERATIONS", "40"],
        ["CONSTANT", "|c| = 0.7885"],
        ["SAMPLES", "2,700"],
        ["ANIMATION", "c ORBIT"],
        ["PALETTE", "10 CHARACTERS"],
      ],
      draw: (t, seed) => juliaFrame(COLS, ROWS, t, seed),
    },
    sine: {
      name: "Sine Wave Field",
      tag: "SINE FIELD",
      formula: "Σ sin(a·u + b·v + ωt)",
      rule: "SUM OF THREE WAVE TERMS",
      iterations: "—",
      note: "Three interfering sine fields are summed per cell, then mapped to a ten-character luminance ramp. Cheap to compute, endlessly different.",
      desc: "A field of overlapping trigonometric waves. Each sample combines a product wave, a diagonal wave and a radial ripple; the scalar result is quantised into characters. Watching it is watching interference.",
      cells: [
        ["DOMAIN", "2D SCALAR FIELD"],
        ["WAVES", "3 TERMS"],
        ["SAMPLES", "2,700"],
        ["MAPPING", "VALUE → RAMP"],
        ["ANIMATION", "PHASE SHIFT"],
        ["PALETTE", "10 CHARACTERS"],
      ],
      draw: (t, seed) => sineFrame(COLS, ROWS, t, seed),
    },
    torus: {
      name: "Rotating Torus",
      tag: "TORUS 3D",
      formula: "(R+r·cos v)·cos u, …",
      rule: "ORTHOGRAPHIC PROJECTION + DEPTH",
      iterations: "—",
      note: "A parametric torus is sampled into points, rotated on two axes, projected to the character grid and depth-tested. Closer surfaces overwrite farther ones.",
      desc: "A torus is parameterised by two angles. Points are rotated in 3D, projected orthographically and written into a depth buffer. Character density encodes the z coordinate, giving a volume without pixels.",
      cells: [
        ["DOMAIN", "PARAMETRIC 3D"],
        ["SAMPLING", "739 POINTS/FRAME"],
        ["PROJECTION", "ORTHOGRAPHIC"],
        ["BUFFER", "DEPTH TEST"],
        ["ANIMATION", "DUAL-AXIS ROTATE"],
        ["PALETTE", "10 CHARACTERS"],
      ],
      draw: (t, seed) => torusFrame(COLS, ROWS, t, seed),
    },
  };

  const params = new URLSearchParams(location.search);
  const requested = params.get("exp");
  let mode: FieldId = requested === "julia" || requested === "sine" || requested === "torus" ? requested : "mandelbrot";
  let seed = 1 + Math.random() * 6;
  let time = 0;
  let playing = false;
  let speed = Number(speedRange.value) / 50;
  let raf = 0;
  let last = 0;
  let drawAcc = 0;
  let fpsFrames = 0;
  let fpsSince = 0;
  let wasPlaying = false;

  function renderBrief() {
    const meta = FIELDS[mode];
    briefName.textContent = meta.name;
    briefDesc.textContent = meta.desc;
    sideNote.textContent = meta.note;
    statMode.textContent = meta.name.toUpperCase();
    statIter.textContent = meta.iterations;
    statRule.textContent = meta.rule;
    footFormula.textContent = meta.formula;
    modeTag.textContent = meta.tag;
    complexityEl.innerHTML = meta.cells.map(([k, v]) => `<div><dt>${k}</dt><dd>${v}</dd></div>`).join("");
  }

  function render() {
    if (!FIELDS[mode]) return;
    fieldEl.textContent = FIELDS[mode].draw(time, seed);
    fieldEl.setAttribute("aria-label", `${FIELDS[mode].name}, generated at ${COLS} by ${ROWS} characters, time ${time.toFixed(2)} seconds`);
    statTime.textContent = `${time.toFixed(2)}s`;
    opEl.textContent = `T+${time.toFixed(2)}s`;
    statScale.textContent = `${speed.toFixed(1)}×`;
    stateEl.textContent = playing ? "RENDERING" : time > 0 ? "PAUSED" : "READY";
    playBtn.textContent = playing ? "❚❚ PAUSE" : time > 0 ? "▶ RESUME" : "▶ RUN";
  }

  function frame(now: number) {
    if (!playing) return;
    if (!last) last = now;
    const dt = Math.min(60, now - last);
    last = now;
    time += (dt / 1000) * speed;
    drawAcc += dt;

    if (drawAcc >= 33) {
      drawAcc = 0;
      render();
      fpsFrames++;
      if (!fpsSince) fpsSince = now;
      if (now - fpsSince >= 600) {
        statFps.textContent = String(Math.round((fpsFrames * 1000) / (now - fpsSince)));
        fpsFrames = 0;
        fpsSince = now;
      }
    }
    raf = requestAnimationFrame(frame);
  }

  function play() {
    if (playing) return;
    playing = true;
    last = 0;
    drawAcc = 0;
    fpsSince = 0;
    render();
    raf = requestAnimationFrame(frame);
  }

  function stop() {
    playing = false;
    cancelAnimationFrame(raf);
    raf = 0;
    statFps.textContent = "—";
    render();
  }

  function mutate() {
    seed = Math.random() * Math.PI * 2;
    render();
  }

  function reset() {
    time = 0;
    seed = 1;
    render();
  }

  modeSelect.value = mode;
  renderBrief();
  render();
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) play();

  modeSelect.addEventListener("change", () => {
    mode = modeSelect.value as FieldId;
    time = 0;
    const url = new URL(location.href);
    url.searchParams.set("exp", mode);
    history.replaceState(null, "", url);
    renderBrief();
    render();
    if (playing) {
      last = 0;
      drawAcc = 0;
    }
  });

  speedRange.addEventListener("input", () => {
    speed = Number(speedRange.value) / 50;
    speedOut.textContent = `${speed.toFixed(1)}×`;
    statScale.textContent = `${speed.toFixed(1)}×`;
  });

  playBtn.addEventListener("click", () => (playing ? stop() : play()));
  mutateBtn.addEventListener("click", mutate);
  resetBtn.addEventListener("click", reset);

  window.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest("input, textarea, select, button, [contenteditable='true']")) return;
    if (e.code === "Space") {
      e.preventDefault();
      playing ? stop() : play();
    } else if (e.key.toLowerCase() === "m") {
      mutate();
    } else if (e.key.toLowerCase() === "r") {
      reset();
    }
  });

  const io = new IntersectionObserver(([entry]) => {
    if (!entry.isIntersecting) {
      if (playing) {
        wasPlaying = true;
        stop();
      }
    } else if (wasPlaying) {
      wasPlaying = false;
      play();
    }
  });
  io.observe(consoleEl);

  document.addEventListener("visibilitychange", () => {
    if (document.hidden && playing) {
      wasPlaying = true;
      stop();
    } else if (!document.hidden && wasPlaying) {
      wasPlaying = false;
      play();
    }
  });
</script>
