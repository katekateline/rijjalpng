<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090909" />
    <title>Untukmu</title>
    <link rel="icon" type="image/png" href="/rizal.png" />
  </head>
  <body>
    <main aria-label="Foto layar penuh">
      <img class="portrait" src="/rizal.png" alt="Foto" />
      <div class="hearts" aria-hidden="true"></div>
      <section class="intro" aria-label="Masuk ke halaman" id="intro">
        <button class="enter-button" id="enter-button" type="button">CLICK AKU 💖</button>
        <div class="love-burst" aria-hidden="true"></div>
      </section>
    </main>
    <audio id="music" src="/oui.mp3" preload="auto" playsinline></audio>

    <script>
      const audio = document.querySelector<HTMLAudioElement>("#music");
      const heartLayer = document.querySelector<HTMLDivElement>(".hearts");
      const intro = document.querySelector<HTMLElement>("#intro");
      const enterButton = document.querySelector<HTMLButtonElement>("#enter-button");
      const burstLayer = document.querySelector<HTMLDivElement>(".love-burst");
      const variants = ["❤️", "💖", "💕", "💗", "💓", "💘"];

      const playFromSixSeconds = () => {
        if (!audio) return;

        audio.currentTime = 6;
        void audio.play().catch((error: unknown) => {
          if (!(error instanceof DOMException && error.name === "NotAllowedError")) {
            console.error("Audio playback failed.", error);
          }
        });
      };

      audio?.addEventListener("ended", () => {
        audio.currentTime = 6;
        void audio.play().catch((error: unknown) => console.error("Audio playback failed.", error));
      });

      enterButton?.addEventListener("click", () => {
        if (!intro || !burstLayer || !enterButton) return;

        playFromSixSeconds();
        document.body.classList.add("entered");
        intro.classList.add("leaving");
        enterButton.disabled = true;

        for (let index = 0; index < 42; index += 1) {
          const heart = document.createElement("span");
          const angle = (Math.PI * 2 * index) / 42 + Math.random() * 0.3;
          const distance = 100 + Math.random() * Math.max(innerWidth, innerHeight) * 0.55;
          heart.className = "burst-heart";
          heart.textContent = variants[Math.floor(Math.random() * variants.length)];
          heart.style.setProperty("--x", `${Math.cos(angle) * distance}px`);
          heart.style.setProperty("--y", `${Math.sin(angle) * distance}px`);
          heart.style.setProperty("--delay", `${Math.random() * 160}ms`);
          burstLayer.append(heart);
          heart.addEventListener("animationend", () => heart.remove(), { once: true });
        }

        window.setTimeout(() => intro.remove(), 1500);
      });

      const dropHeart = () => {
        if (!heartLayer) return;

        const heart = document.createElement("span");
        heart.className = "heart";
        heart.textContent = variants[Math.floor(Math.random() * variants.length)];
        heart.style.left = `${Math.random() * 100}vw`;
        heart.style.fontSize = `${16 + Math.random() * 24}px`;
        heart.style.animationDuration = `${5 + Math.random() * 5}s`;
        heart.style.setProperty("--drift", `${(Math.random() - 0.5) * 180}px`);
        heartLayer.append(heart);
        heart.addEventListener("animationend", () => heart.remove(), { once: true });
      };

      window.setInterval(() => {
        if (document.body.classList.contains("entered")) dropHeart();
      }, 420);
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #090909;
  }

  main {
    position: fixed;
    inset: 0;
    overflow: hidden;
  }

  .portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1.12);
    filter: blur(18px);
    transition:
      opacity 1s ease,
      transform 1.6s cubic-bezier(0.16, 1, 0.3, 1),
      filter 1.4s ease;
  }

  :global(body.entered) .portrait {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
  }

  .hearts {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .intro {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #080808;
    transition:
      opacity 850ms ease,
      transform 1.2s cubic-bezier(0.7, 0, 0.2, 1),
      filter 1s ease;
  }

  .intro.leaving {
    opacity: 0;
    transform: scale(1.7);
    filter: blur(16px);
    pointer-events: none;
  }

  .enter-button {
    position: relative;
    z-index: 1;
    padding: 1.1rem 2rem;
    border: 1px solid #aaa;
    border-radius: 999px;
    color: #f5f5f5;
    background: #222;
    box-shadow: 0 0 24px rgb(255 255 255 / 12%);
    font: 800 1.15rem/1.2 system-ui, sans-serif;
    letter-spacing: 0.04em;
    cursor: pointer;
    animation: pulse 1.3s ease-in-out infinite alternate;
  }

  .enter-button:focus-visible {
    outline: 3px solid white;
    outline-offset: 6px;
  }

  .love-burst {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  :global(.burst-heart) {
    position: absolute;
    top: 50%;
    left: 50%;
    font-size: clamp(1.5rem, 5vw, 3.5rem);
    line-height: 1;
    animation: burst 1.15s cubic-bezier(0.15, 0.7, 0.25, 1) var(--delay) both;
  }

  @keyframes pulse {
    to {
      transform: scale(1.08);
      box-shadow: 0 0 32px rgb(255 255 255 / 25%);
    }
  }

  @keyframes burst {
    from {
      opacity: 1;
      transform: translate(-50%, -50%) scale(0.2) rotate(0);
    }
    to {
      opacity: 0;
      transform: translate3d(var(--x), var(--y), 0) scale(1.2) rotate(720deg);
    }
  }

  :global(.heart) {
    position: absolute;
    top: -3rem;
    line-height: 1;
    animation: fall linear forwards;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 25%));
  }

  @keyframes fall {
    to {
      transform: translate3d(var(--drift), 110vh, 0) rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.heart),
    :global(.burst-heart) {
      display: none;
    }

    .enter-button,
    .portrait,
    .intro {
      animation: none;
      transition-duration: 0.01ms;
    }
  }
</style>
