---
import Base from "../layouts/Base.astro";
import { experiments } from "../data/experiments";

const selected = ["quick", "astar", "life", "golden"]
  .map((id) => experiments.find((e) => e.id === id))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));
---

<Base title="SORT//VOID — Every algorithm leaves a pattern" description="An experimental playground where computation becomes art.">
  <section class="intro" id="hero">
    <div class="intro-stage" id="hero-stage">
      <pre
        id="hero-art"
        class="ascii hero-art"
        role="img"
        aria-label="A rotating sphere and particle halo drawn entirely with ASCII characters"
      >LOADING CHARACTER FIELD…</pre>
      <div class="stage-meta">
        <span>OBJ_001 / PARTICLE SPHERE</span>
        <span id="hero-clock">T+000.0</span>
      </div>
    </div>

    <div class="intro-copy">
      <h1>SORT<span class="slash">//</span>VOID</h1>
      <p class="tagline">EVERY ALGORITHM<br />LEAVES A PATTERN.</p>
      <p class="lede">Explore the beauty hidden inside computation.</p>
      <a class="btn btn--primary" href="/experiments/">EXPLORE <span aria-hidden="true">→</span></a>
      <span class="scroll-cue">SCROLL TO DISCOVER <span aria-hidden="true">↓</span></span>
    </div>
  </section>

  <section class="selected" aria-labelledby="selected-title">
    <div class="selected-head">
      <h2 id="selected-title">SELECTED <span>/ 04</span></h2>
      <a href="/experiments/">FULL INDEX <span aria-hidden="true">→</span></a>
    </div>
    <div class="selected-grid">
      {selected.map((exp, i) => (
        <a class="selected-item" href={exp.href}>
          <pre class="selected-art" aria-hidden="true">{exp.art}</pre>
          <div class="selected-meta">
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <span class="cat">{exp.category}</span>
          </div>
          <h3>{exp.name}</h3>
          <span class="open">OPEN <span aria-hidden="true">↗</span></span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    min-height: min(54vh, 520px);
    padding: clamp(1.2rem, 3vw, 2.4rem) 0 clamp(1.2rem, 2.5vw, 2rem);
  }

  .intro-stage {
    position: relative;
    min-width: 0;
    padding: 0.5rem 0;
    background: radial-gradient(ellipse at 50% 50%, rgba(77, 255, 145, 0.07), transparent 66%);
  }

  .hero-art {
    font-size: clamp(5px, 0.95vw, 12px);
    line-height: 1.1;
    min-height: 180px;
    margin: 0 auto;
    width: max-content;
    max-width: 100%;
    color: var(--green);
    text-shadow: 0 0 9px rgba(77, 255, 145, 0.38);
  }

  .stage-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.4rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--line);
    font-size: 8px;
    letter-spacing: 0.16em;
    color: var(--dim);
    text-transform: uppercase;
  }

  .intro-copy { min-width: 0; }

  .intro-copy h1 {
    font-size: clamp(2.4rem, 6vw, 5.2rem);
    line-height: 0.82;
    letter-spacing: -0.07em;
    font-weight: 800;
    margin: 0 0 1rem;
    white-space: nowrap;
    animation: flicker 9s linear infinite;
  }

  .intro-copy h1 .slash { color: var(--green); text-shadow: 0 0 24px rgba(77, 255, 145, 0.4); }

  .tagline {
    font-size: clamp(0.8rem, 1.3vw, 0.95rem);
    letter-spacing: 0.19em;
    line-height: 1.55;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    max-width: 28ch;
  }

  .lede {
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
    max-width: 34ch;
  }

  .intro-copy .btn { margin-top: 1.2rem; }

  .scroll-cue {
    display: block;
    margin-top: 1.4rem;
    font-size: 8px;
    letter-spacing: 0.2em;
    color: var(--dim);
    text-transform: uppercase;
  }

  .selected {
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--line);
  }

  .selected-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }

  .selected-head h2 {
    font-size: 11px;
    letter-spacing: 0.22em;
    font-weight: 400;
    color: var(--text);
  }

  .selected-head h2 span { color: var(--dim); }

  .selected-head a {
    font-size: 9px;
    letter-spacing: 0.18em;
    color: var(--green);
    border-bottom: 1px solid var(--line-hot);
    padding-bottom: 2px;
  }

  .selected-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .selected-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.8rem;
    background: var(--bg);
    min-width: 0;
    transition: background 160ms linear;
  }

  .selected-item:hover { background: var(--panel); }

  .selected-art {
    font-size: 8px;
    line-height: 1.16;
    color: var(--green);
    opacity: 0.72;
    height: 86px;
    overflow: hidden;
    white-space: pre;
    text-shadow: 0 0 5px rgba(77, 255, 145, 0.25);
    transition: opacity 160ms linear;
  }

  .selected-item:hover .selected-art { opacity: 1; }

  .selected-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.55rem;
    font-size: 8px;
    letter-spacing: 0.16em;
    color: var(--dim);
    text-transform: uppercase;
  }

  .selected-meta .num { color: var(--green); }

  .selected-item h3 {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .open {
    margin-top: auto;
    padding-top: 0.7rem;
    font-size: 8px;
    letter-spacing: 0.18em;
    color: var(--green);
    text-transform: uppercase;
    opacity: 0;
    transition: opacity 160ms linear;
  }

  .selected-item:hover .open,
  .selected-item:focus-visible .open { opacity: 1; }

  @media (max-width: 980px) {
    .intro { grid-template-columns: 1fr; min-height: 0; gap: 1.5rem; }
    .intro-stage { order: 2; }
    .hero-art { font-size: clamp(6px, 2.15vw, 12px); }
    .selected-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .selected-grid { grid-template-columns: 1fr; }
    .intro-copy h1 { font-size: clamp(2.6rem, 13vw, 4rem); }
    .hero-art { font-size: 6px; }
  }
</style>

<script>
  import { mountSphere } from "../engines/ascii/hero";

  const art = document.getElementById("hero-art") as HTMLPreElement | null;
  const stage = document.getElementById("hero-stage");
  const clockEl = document.getElementById("hero-clock");

  if (art && stage) mountSphere(art, stage);

  if (clockEl) {
    const start = performance.now();
    window.setInterval(() => {
      const seconds = (performance.now() - start) / 1000;
      clockEl.textContent = `T+${seconds.toFixed(1).padStart(5, "0")}`;
    }, 500);
  }
</script>
